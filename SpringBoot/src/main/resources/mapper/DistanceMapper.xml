<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.bultrail.markroad.mapper.DistanceMapper">
    <resultMap id="BaseResultMap" type="top.bultrail.markroad.entity.DistanceNode">
        <id column="start_id" jdbcType="INTEGER" property="nodeStartId"/>
        <id column="end_id" jdbcType="INTEGER" property="nodeEndId"/>
        <result column="dis" jdbcType="DOUBLE" property="distance"/>
    </resultMap>
    <!-- 批量插入数据 忽略主键或者唯一索引冲突，继续执行后续插入，不会抛出异常-->
    <insert id="batchInsertDistance" parameterType="java.util.List">
        INSERT IGNORE INTO distance (start_id, end_id, dis)
        VALUES
        <foreach collection="list" item="item" index="index" separator=",">
            (#{item.nodeStartId,jdbcType=INTEGER}, #{item.nodeEndId,jdbcType=INTEGER}, #{item.distance,jdbcType=DOUBLE})
        </foreach>
    </insert>
    <update id="truncateDistance">
        TRUNCATE TABLE distance
    </update>
    <select id="selectAllDistance" resultType="top.bultrail.markroad.entity.DistanceNode">
--         SELECT * FROM distance
    SELECT
        start_id as nodeStartId,
        end_id as nodeEndId,
        dis as distance
    FROM distance
    </select>
    <!--    <select id="selectAllNode" resultType="BaseResultMap">-->
    <!--        SELECT * FROM node-->
    <!--    </select>-->

    <!-- 添加带LIMIT的距离查询 -->
    <select id="selectDistanceWithLimit" resultType="top.bultrail.markroad.entity.DistanceNode">
    SELECT * FROM distance LIMIT #{limit}
    </select>

    <!-- 添加分批查询（使用LIMIT和OFFSET） -->
    <select id="selectDistanceBatch" resultType="top.bultrail.markroad.entity.DistanceNode">
        SELECT
            start_id as nodeStartId,
            end_id as nodeEndId,
            dis as distance
        FROM distance
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <!-- 添加总记录数查询 -->
    <select id="countAllDistance" resultType="int">
        SELECT COUNT(*) FROM distance
    </select>
    <select id="selectDistanceByNodes" resultType="top.bultrail.markroad.entity.DistanceNode">
    SELECT
        start_id as nodeStartId,
        end_id as nodeEndId,
        dis as distance
    FROM distance
    WHERE start_id = #{startId} AND end_id = #{endId}
</select>
</mapper>