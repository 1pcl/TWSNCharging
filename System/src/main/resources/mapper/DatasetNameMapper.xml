<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.bultrail.markroad.mapper.DatasetNameMapper">
    <resultMap id="BaseResultMap" type="top.bultrail.markroad.entity.DatasetName">
        <id column="name" jdbcType="VARCHAR" property="name"/>
        <result column="sensor_size" jdbcType="INTEGER" property="sensorSize"/>
        <result column="relay_size" jdbcType="INTEGER" property="relaySize"/>
        <result column="station_size" jdbcType="INTEGER" property="stationSize"/>
        <result column="intersection_size" jdbcType="INTEGER" property="intersectionSize"/>
        <result column="location_lng" jdbcType="DOUBLE" property="locationLng"/>
        <result column="location_lat" jdbcType="DOUBLE" property="locationLat"/>
        <result column="is_dataset" jdbcType="INTEGER" property="isDataset"/>
    </resultMap>
    <resultMap id="datasetLocationMap" type="top.bultrail.markroad.entity.DatasetLocation">
        <result column="location_lng" jdbcType="DOUBLE" property="locationLng"/>
        <result column="location_lat" jdbcType="DOUBLE" property="locationLat"/>
    </resultMap>

    <sql id="Base_Column_List">
        `name`, sensor_size, relay_size,station_size,intersection_size, location_lng, location_lat,is_dataset
    </sql>
    <select id="selectByPrimaryKey" parameterType="java.lang.String" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from dataset_name
        where `name` = #{name,jdbcType=VARCHAR}
    </select>
    <select id="selectDatasetInfo" resultType="top.bultrail.markroad.entity.DatasetInfo">
        SELECT `name`, sensor_size, relay_size,station_size,intersection_size, location_lng, location_lat,is_dataset FROM dataset_name
    </select>
    <select id="selectDatasetLocation" resultMap="datasetLocationMap">
        SELECT location_lng, location_lat FROM dataset_name WHERE name = #{setName}
    </select>
    <select id="existsByName" resultType="java.lang.Boolean">
        SELECT COUNT(*) > 0
        FROM dataset_name
        WHERE name = #{name}
    </select>

    <delete id="deleteByPrimaryKey" parameterType="java.lang.String">
        delete from dataset_name
        where `name` = #{name,jdbcType=VARCHAR}
    </delete>
    <insert id="insertSelective" keyColumn="name" keyProperty="name"
            parameterType="top.bultrail.markroad.entity.DatasetName" useGeneratedKeys="true">
        insert into dataset_name
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="sensorSize != null">
                sensor_size,
            </if>
            <if test="relay_size != null">
                relay_size,
            </if>
            <if test="station_size != null">
                station_size,
            </if>
            <if test="intersection_size != null">
                intersection_size,
            </if>
            <if test="locationLng != null">
                location_lng,
            </if>
            <if test="locationLat != null">
                location_lat,
            </if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="sensorSize != null">
                #{sensorSize,jdbcType=INTEGER},
            </if>
            <if test="relay_size != null">
                #{relay_size,jdbcType=INTEGER},
            </if>
            <if test="station_size != null">
                #{station_size,jdbcType=INTEGER},
            </if>
            <if test="intersection_size != null">
                #{intersection_size,jdbcType=INTEGER},
            </if>
            <if test="locationLng != null">
                #{locationLng,jdbcType=DOUBLE},
            </if>
            <if test="locationLat != null">
                #{locationLat,jdbcType=DOUBLE},
            </if>
        </trim>
    </insert>
    <insert id="insertDatasetInfo">
        INSERT INTO dataset_name (name, sensor_size, relay_size, station_size,intersection_size,location_lng, location_lat,is_dataset)
        VALUES (
        #{setName},
        (SELECT COUNT(*) FROM sensor),
        (SELECT COUNT(*) FROM relay),
        (SELECT COUNT(*) FROM station),
        (SELECT COUNT(*) FROM intersection),
        #{locationLng},
        #{locationLat},
        1
        )
    </insert>
    <update id="updateByPrimaryKeySelective" parameterType="top.bultrail.markroad.entity.DatasetName">
        update dataset_name
        <set>
            <if test="sensorSize != null">
                sensor_size = #{sensorSize,jdbcType=INTEGER},
            </if>
            <if test="relay_size != null">
                relay_size = #{gateWaySize,jdbcType=INTEGER},
            </if>
            <if test="station_size != null">
                station_size = #{sensorSize,jdbcType=INTEGER},
            </if>
            <if test="intersection_size != null">
                intersection_size = #{gateWaySize,jdbcType=INTEGER},
            </if>
            <if test="locationLng != null">
                location_lng = #{locationLng,jdbcType=DOUBLE},
            </if>
            <if test="locationLat != null">
                location_lat = #{locationLat,jdbcType=DOUBLE},
            </if>
        </set>
        where `name` = #{name,jdbcType=VARCHAR}
    </update>
    <update id="updateByPrimaryKey" parameterType="top.bultrail.markroad.entity.DatasetName">
        update dataset_name
        set sensor_size = #{sensorSize,jdbcType=INTEGER},
        relay_size = #{relay_size,jdbcType=INTEGER},
        station_size = #{station_size,jdbcType=INTEGER},
        intersection_size = #{intersection_size,jdbcType=INTEGER},
        location_lng = #{locationLng,jdbcType=DOUBLE},
        location_lat = #{locationLat,jdbcType=DOUBLE}
        where `name` = #{name,jdbcType=VARCHAR}
    </update>
    <update id="updateDatasetName">
        UPDATE dataset_name
        SET name = #{newName}
        WHERE name = #{oldName}
    </update>
    <select id="selectNamesByIsDataset" resultType="java.lang.String">
    SELECT `name`
    FROM dataset_name
    WHERE is_dataset = 1
    </select>
    <update id="updateIsDatasetStatus">
    UPDATE dataset_name
    SET is_dataset = #{status}
    WHERE `name` = #{name}
    </update>
</mapper>